# Database - Neon PostgreSQL
# DATABASE_URL: Pooled connection string (used in production runtime)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# DIRECT_URL: Direct, non-pooled connection string (used for Prisma migrations)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth / Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-character-secret"

# Admin Initial Seed Credentials
SEED_ADMIN_EMAIL="admin@skillpulse.local"
SEED_ADMIN_PASSWORD="AdminSecurePassword123!"

# Storage (Vercel Blob / S3 / Local Mock)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_placeholder"
STORAGE_PROVIDER="mock" # Options: "mock" (built-in safe demo storage), "vercel-blob", "s3"

# Email Configuration (Optional - if omitted, admin UI displays reset links directly)
RESEND_API_KEY=""
EMAIL_FROM="SkillPulse <noreply@skillpulse.local>"
